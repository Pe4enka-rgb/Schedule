<UserControl
    x:Class="Schedule.View.EntityView.SubjectView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dataGrid2D="http://gu.se/DataGrid2D"
    xmlns:evm="clr-namespace:Schedule.ViewModels.EntityViewModels"
    xmlns:local="clr-namespace:Schedule.View"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignWidth="450"
    d:DesignHeight="150"
    DataContext="{Binding SubjectViewModel, Source={StaticResource Locator}}"
    mc:Ignorable="d">

    <b:Interaction.Triggers>
        <b:EventTrigger EventName="Loaded">
            <b:InvokeCommandAction Command="{Binding LoadDataCommand}" />
        </b:EventTrigger>
    </b:Interaction.Triggers>

    <DockPanel Background="Snow">

        <WrapPanel DockPanel.Dock="Top">
            <Button
                Name="BtnAdd"
                Command="{Binding AddSubjectCommand}"
                Content="Добавить" />
            <Button
                Name="BtnDelete"
                Command="{Binding DeleteSubjectCommand}"
                CommandParameter="{Binding SelectedSubject}"
                Content="Удалить" />
            <Button
                Name="BtnEdit"
                Command="{Binding EditSubjectCommand}"
                CommandParameter="{Binding SelectedSubject}"
                Content="Изменить" />
        </WrapPanel>

        <GroupBox Header="Предметы">
            <DataGrid
                Width="auto"
                dataGrid2D:Index.StartAt="1"
                DockPanel.Dock="Top"
                HeadersVisibility="All"
                IsReadOnly="True"
                ItemsSource="{Binding Subjects}"
                RowHeaderStyle="{StaticResource RowNumbersStyle}"
                SelectedItem="{Binding SelectedSubject}"
                SelectionMode="Extended">
                <DataGrid.Columns>
                    <DataGridTextColumn
                        Width="auto"
                        Binding="{Binding Name}"
                        Header="Название" />
                    <DataGridTextColumn
                        Width="auto"
                        Binding="{Binding Difficulty}"
                        Header="Сложность" />
                    <DataGridTextColumn
                        Width="auto"
                        Binding="{Binding HoursPerDay}"
                        Header="Часов в День" />
                    <DataGridTextColumn
                        Width="auto"
                        Binding="{Binding HoursPerWeek}"
                        Header="Часов в Неделю" />
                </DataGrid.Columns>
            </DataGrid>
        </GroupBox>
    </DockPanel>

</UserControl>

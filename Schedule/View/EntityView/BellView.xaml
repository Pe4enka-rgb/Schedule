<UserControl
    x:Class="Schedule.View.EntityView.BellView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dataGrid2D="http://gu.se/DataGrid2D"
    xmlns:e="clr-namespace:Schedule.DB.Entity;assembly=Schedule.DB"
    xmlns:evm="clr-namespace:Schedule.ViewModels.EntityViewModels"
    xmlns:local="clr-namespace:Schedule.View"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    DataContext="{Binding BellViewModel, Source={StaticResource Locator}}"
    d:DesignHeight="100"
    d:DesignWidth="300"
    mc:Ignorable="d">

    <UserControl.Resources>
        <DataTemplate DataType="{x:Type e:Bell}">
            <StackPanel>
                <TextBlock Text="{Binding Start}" />
                <TextBlock Text="{Binding End}" />
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <b:Interaction.Triggers>
        <b:EventTrigger EventName="Loaded">
            <b:InvokeCommandAction Command="{Binding LoadDataCommand}" />
        </b:EventTrigger>
    </b:Interaction.Triggers>

    <DockPanel Background="Snow">
        <WrapPanel DockPanel.Dock="Top">
            <Button
                x:Name="BtnAdd"
                Command="{Binding AddBellCommand}"
                Content="Добавить" />
            <Button
                x:Name="BtnDelete"
                Command="{Binding DeleteBellCommand}"
                CommandParameter="{Binding SelectedBell}"
                Content="Удалить" />
            <Button
                x:Name="BtnEdit"
                Command="{Binding EditBellCommand}"
                CommandParameter="{Binding SelectedBell}"
                Content="Изменить" />
        </WrapPanel>

        <DataGrid
            Margin="3"
            dataGrid2D:Index.StartAt="1"
            DockPanel.Dock="Top"
            IsReadOnly="True"
            ItemsSource="{Binding Bells}"
            RowHeaderStyle="{StaticResource RowNumbersStyle}"
            SelectedItem="{Binding SelectedBell}"
            SelectionMode="Single">

            <DataGrid.Columns>

                <DataGridTextColumn
                    Width="auto"
                    Binding="{Binding Start, StringFormat=HH:mm}"
                    Header="Начало" />

                <DataGridTextColumn
                    Width="auto"
                    Binding="{Binding End, StringFormat=HH:mm}"
                    Header="Конец" />

            </DataGrid.Columns>
        </DataGrid>
        <Grid />
    </DockPanel>

</UserControl>

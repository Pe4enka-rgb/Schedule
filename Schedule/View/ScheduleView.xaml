<UserControl
    x:Class="Schedule.View.ScheduleView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:data="clr-namespace:Schedule.Data"
    xmlns:dd="urn:gong-wpf-dragdrop"
    xmlns:dg2D="http://gu.se/DataGrid2D"
    xmlns:e="clr-namespace:Schedule.DB.Entity;assembly=Schedule.DB"
    xmlns:infrastracture="clr-namespace:Schedule.Infrastracture"
    xmlns:m="clr-namespace:Schedule.Model"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:system="clr-namespace:System;assembly=System.Runtime"
    xmlns:view="clr-namespace:Schedule.View"
    Margin="0"
    d:DesignHeight="450"
    d:DesignWidth="800"
    DataContext="{Binding Path=ScheduleViewModel, Source={StaticResource Locator}}"
    mc:Ignorable="d">
    <UserControl.Resources>
        <data:DayOfWeekToRussianStringConverter x:Key="DayOfWeekConverter" />
        <data:DayOfWeekToLocalizedStringConverter x:Key="DayOfWeekToLocalizedStringConverter" />
        <DataTemplate DataType="{x:Type system:DayOfWeek}">
            <TextBlock FontSize="20" Text="{Binding Converter={StaticResource DayOfWeekToLocalizedStringConverter}}" />
        </DataTemplate>
    </UserControl.Resources>

    <b:Interaction.Triggers>
        <b:EventTrigger EventName="Loaded">
            <b:InvokeCommandAction Command="{Binding LoadDataCommand}" />
        </b:EventTrigger>
    </b:Interaction.Triggers>

    <DockPanel Background="DarkCyan">
        <StackPanel Width="150">

            <TextBlock
                HorizontalAlignment="Center"
                FontSize="24"
                Foreground="Snow"
                Text="Классы" />

            <!--  Список годов обучения  -->
            <TreeView
                Padding="10"
                Background="DarkCyan"
                BorderBrush="DarkCyan"
                DockPanel.Dock="Left"
                Foreground="Snow"
                ItemTemplate="{StaticResource GradeWithClassesTemplate}"
                ItemsSource="{Binding GradeWithSchoolClassesList}">
                <TreeView.ItemContainerStyle>
                    <Style BasedOn="{StaticResource {x:Type TreeViewItem}}" TargetType="{x:Type TreeViewItem}">
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="BorderBrush" Value="MediumAquamarine" />
                                <Setter Property="BorderThickness" Value="1" />
                                <Setter Property="Background" Value="Black" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsSelected" Value="True" />
                                    <Condition Property="IsSelectionActive" Value="False" />
                                </MultiTrigger.Conditions>
                                <Setter Property="BorderBrush" Value="Black" />
                            </MultiTrigger>
                        </Style.Triggers>

                    </Style>
                </TreeView.ItemContainerStyle>
                <!--  Список классов в каждом году  -->
                <TreeView.Resources />
                <!--  Возможность выбрать класс  -->
                <b:Interaction.Behaviors>
                    <infrastracture:BindableSelectedItemBehavior SelectedItem="{Binding SelectedSchoolClass, Mode=TwoWay}" />
                </b:Interaction.Behaviors>

            </TreeView>
        </StackPanel>
        <view:SubjectsListToDragView DockPanel.Dock="Left" />
        <WrapPanel Background="Snow" DockPanel.Dock="Top">
            <TextBlock FontSize="20" Text="Расписание класса: " />
            <TextBlock FontSize="20" Text="{Binding SelectedSchoolClass.Grade.Year}" />
            <TextBlock FontSize="20" Text="{Binding SelectedSchoolClass.Letter}" />
        </WrapPanel>
        <DataGrid
            dd:DragDrop.DragAdornerTemplate="{Binding HoveredValue}"
            dd:DragDrop.DropHandler="{Binding}"
            dd:DragDrop.IsDropTarget="True"
            dg2D:Cell.Template="{StaticResource LessonModelTemplate}"
            dg2D:ItemsSource.ColumnHeadersSource="{Binding DaysOfWeek}"
            dg2D:ItemsSource.ColumnsSource="{Binding LessonsList}"
            dg2D:ItemsSource.RowHeadersSource="{Binding Bells}"
            dg2D:Selected.CellItem="{Binding SelectedDataGridLesson}"
            AutoGenerateColumns="True"
            CanUserReorderColumns="False"
            DockPanel.Dock="Top"
            FontSize="16"
            HeadersVisibility="All"
            SelectionMode="Single"
            SelectionUnit="Cell">
            <!--<DataGrid.Columns>
                <DataGridTextColumn Header="Понедельник" />
                <DataGridTextColumn Header="Вторник" />
                <DataGridTextColumn Header="Среда" />
                <DataGridTextColumn Header="Четверг" />
                <DataGridTextColumn Header="Пятница" />
                <DataGridTextColumn Header="Суббота" />
            </DataGrid.Columns>-->
            <!--  Биндинг для получения элемента Lesson под мышью  -->
            <DataGrid.RowHeaderStyle>
                <Style BasedOn="{StaticResource {x:Type DataGridRowHeader}}" TargetType="DataGridRowHeader">
                    <Setter Property="Padding" Value="3" />
                    <Setter Property="BorderBrush" Value="DarkCyan" />
                    <Setter Property="BorderThickness" Value="0,0,1,1" />
                    <Setter Property="FontSize" Value="16" />
                    <Setter Property="HorizontalAlignment" Value="Center" />
                </Style>
            </DataGrid.RowHeaderStyle>
            <DataGrid.ColumnHeaderStyle>
                <Style BasedOn="{StaticResource {x:Type DataGridColumnHeader}}" TargetType="DataGridColumnHeader">

                    <Setter Property="HorizontalContentAlignment" Value="Center" />
                </Style>
            </DataGrid.ColumnHeaderStyle>
            <b:Interaction.Behaviors>
                <infrastracture:MouseEnterBehavior />
            </b:Interaction.Behaviors>
        </DataGrid>
        <Grid DockPanel.Dock="Bottom" />

    </DockPanel>
</UserControl>
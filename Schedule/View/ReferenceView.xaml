<UserControl
    x:Class="Schedule.View.ReferenceView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:EntityView="clr-namespace:Schedule.View.EntityView"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:evm="clr-namespace:Schedule.ViewModels.EntityViewModels"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:local="clr-namespace:Schedule.View"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    DataContext="{Binding Path=ReferenceViewModel, Source={StaticResource Locator}}"
    mc:Ignorable="d">
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding Path=LoadDataCommand}" />
        </i:EventTrigger>
    </i:Interaction.Triggers>
    <DockPanel>
        <TabControl Background="Snow">
            <TabItem Header="Уровни обучения">
                <EntityView:GradeView />
            </TabItem>
            <TabItem Header="Предметы">
                <EntityView:SubjectView />
            </TabItem>
            <TabItem Header="Звонки">
                <EntityView:BellView />
            </TabItem>
            <TabItem Header="Классы">
                <EntityView:SchoolClassView />
            </TabItem>
        </TabControl>

    </DockPanel>
</UserControl>

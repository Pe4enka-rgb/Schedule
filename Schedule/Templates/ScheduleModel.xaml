<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:e="clr-namespace:Schedule.DB.Entity;assembly=Schedule.DB"
    xmlns:m="clr-namespace:Schedule.Model">

    <DataTemplate x:Key="LessonModelTemplate" DataType="{x:Type m:LessonModel}">
        <TextBlock Text="{Binding Subject.Name}" />
    </DataTemplate>

    <DataTemplate x:Key="BellModelTemplate" DataType="{x:Type m:BellModel}">
        <WrapPanel>
            <TextBlock Text="{Binding Bell.Start, StringFormat=HH:mm}" />
            <TextBlock Text=" - " />
            <TextBlock Text="{Binding Bell.End, StringFormat=HH:mm}" />
        </WrapPanel>
    </DataTemplate>

    <DataTemplate x:Key="SchoolClassTemplate" DataType="{x:Type e:SchoolClass}">
        <WrapPanel>
            <TextBlock
                FontSize="18"
                Foreground="Snow"
                Text="{Binding Grade.Year}" />
            <TextBlock
                FontSize="18"
                Foreground="Snow"
                Text="{Binding Letter}" />
            <TextBlock
                FontSize="18"
                Foreground="Snow"
                Text=" Класс" />
        </WrapPanel>
    </DataTemplate>

    <HierarchicalDataTemplate
        x:Key="GradeWithClassesTemplate"
        DataType="{x:Type m:GradeWithSchoolClasses}"
        ItemTemplate="{StaticResource SchoolClassTemplate}"
        ItemsSource="{Binding SchoolClasses}">
        <WrapPanel>
            <TextBlock
                FontSize="24"
                Foreground="Snow"
                Text="{Binding Grade.Year}" />
            <TextBlock
                FontSize="24"
                Foreground="Snow"
                Text=" Год" />
        </WrapPanel>

    </HierarchicalDataTemplate>


</ResourceDictionary>